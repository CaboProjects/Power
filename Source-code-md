import os
import ctypes
import sys

def is_admin():
    try:
        return ctypes.windll.shell32.IsUserAnAdmin()
    except Exception:
        return False

def launch_bypass_shell():
    custom_prompt = 'function prompt { "power> " }'

    cmd = (
        f'powershell.exe -NoExit '
        f'-ExecutionPolicy Bypass '
        f'-Command "{custom_prompt}"'
    )

    print("Bypassing execution policies and launching shell...")
    os.system(cmd)

if __name__ == "__main__":
    if is_admin():
        launch_bypass_shell()
    else:
        print("Requesting administrator privileges...")

        ctypes.windll.shell32.ShellExecuteW(
            None,
            "runas",
            sys.executable,
            " ".join(sys.argv),
            None,
            1
        )
